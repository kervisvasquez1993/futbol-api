NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=futbol_tracker

JWT_SECRET=super-secret-key-change-me
JWT_EXPIRES_IN=1d

# S3 (subida de imágenes de perfil de jugadores). Opcionales: si quedan vacías,
# la app arranca igual, pero el endpoint de subida (cuando exista) va a fallar
# al intentar usarlas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Tiene que ser el nombre de un bucket que ya exista en la cuenta — este es
# solo un ejemplo de formato, no lo dejes así sin cambiarlo.
AWS_BUCKET=tu-bucket-real
# true solo si usás un S3 compatible (MinIO, DigitalOcean Spaces, etc.) que
# necesite URLs "path-style". Para AWS S3 real, dejar en false.
AWS_USE_PATH_STYLE_ENDPOINT=false
# Opcional: dominio público desde donde se sirven las imágenes (ej. CloudFront).
# Si se deja vacío, se arma como https://<bucket>.s3.<region>.amazonaws.com
AWS_S3_PUBLIC_URL=
